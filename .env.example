# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 git 에 올라가지 않습니다.
#   cp .env.example .env
#
# start-demo.ps1 을 쓰면 JWT_SECRET 은 없을 때 자동으로 만들어 줍니다.

# JWT 서명 키 — 반드시 직접 만드세요. 기본값이 없어서 비워 두면 백엔드가 뜨지 않습니다.
# 대칭키라서 이 값을 아는 사람은 아무 사용자의 토큰이든 위조할 수 있습니다.
# 만드는 법 (PowerShell):
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=

# 로컬 개발용 DB 비밀번호. 비워 두면 1234 로 뜹니다.
# 5432 는 127.0.0.1 에만 열려 있어서 이 PC 밖에서는 접근되지 않습니다.
# 다른 곳에 배포한다면 반드시 바꾸세요.
POSTGRES_PASSWORD=1234

# 생성형 답변용 키. 없으면 답변 생성만 꺼지고 조문 검색은 그대로 동작합니다.
# 이 파일에 적지 말고 사용자 환경변수에 넣는 것을 권장합니다.
#   setx GEMINI_API_KEY "발급받은_키"
GEMINI_API_KEY=
